[app]
loglevel=debug

[logging]
# Syslog server as host:port (UDP), empty logs to stdout only
syslog_path=
# Streams sent to syslog: app, siem, public_inspect, debug
syslog_streams=app,siem,public_inspect
# Name of this application in every log record
application_id=prs-saml
# Streams printed to stdout: app, siem, debug
console_streams=debug
# Include tracebacks in logs
include_traces=True
# Log every request
access_logs=True
# Log an error when X-GF-Correlation-ID is missing
correlation_id_expected=False
# Take the client ip from X-Forwarded-For, only enable behind a trusted proxy
trust_forwarded_for=False

[uvicorn]
swagger_enabled = True
docs_url = /docs
redoc_url = /redocs
host = 0.0.0.0
port = 8534
reload = True

use_ssl = False
ssl_base_dir = secrets/ssl
ssl_cert_file = server.cert
ssl_key_file = server.key
# The root path if behind a proxy
root_path =
