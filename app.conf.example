[app]
loglevel=debug

[logging]
# All keys are optional.
# Log server in host:port format (UDP). Leave empty to log to stdout only.
syslog_path=
# Streams sent to the log server, comma separated, from app, siem,
# public_inspect and debug. Each JSON record carries its stream_id.
syslog_streams=app,siem,public_inspect
# Stamped on every JSON record as application_id, so the log server can tell
# applications sharing the channel apart.
application_id=prs-saml
# Streams printed to stdout as readable text, comma separated, from app, siem
# and debug. The debug stream already holds every record.
console_streams=debug
# Include tracebacks on the console and on the debug stream.
include_traces=True
# Emit an access record per request.
access_logs=True
# Log an error when a request arrives without an X-GF-Correlation-ID header.
correlation_id_expected=False
# Read the client ip from X-Forwarded-For instead of the connection. The header
# is set by the caller, so only enable this where a proxy in front of this
# application rewrites it.
trust_forwarded_for=False

[uvicorn]
swagger_enabled = True
docs_url = /docs
redoc_url = /redocs
host = 0.0.0.0
port = 8534
reload = True

use_ssl = False
ssl_base_dir = secrets/ssl
ssl_cert_file = server.cert
ssl_key_file = server.key
# The root path if behind a proxy
root_path =
